{
  // Entorno para abrir el repositorio en Codespaces. Mismo Python y mismo lock que en local y en CI.
  "name": "Priorizador de leads",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "app/streamlit_app.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  // uv con versión fija (la del desarrollo) y el entorno instalado desde uv.lock, sin pip.
  "updateContentCommand": "curl -LsSf https://astral.sh/uv/0.9.24/install.sh | sh && ~/.local/bin/uv sync --frozen",
  // La app necesita .streamlit/secrets.toml (ver .streamlit/secrets.toml.example); sin él, lo avisa.
  "postAttachCommand": {
    "server": "~/.local/bin/uv run streamlit run app/streamlit_app.py --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
